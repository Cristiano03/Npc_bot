# Configurazione Discord Bot
DISCORD_TOKEN=your_discord_token_here

# Configurazione Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=openhermes

# Configurazione Server
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Configurazione Database
DATABASE_PATH=database.db

# Forza compatibilità GPU AMD (opzionale)
# Impostare HSA_OVERRIDE_GFX_VERSION per forzare compatibilità con alcune GPU AMD (es. Radeon 6700 XT).
# Valore d'esempio: 'gfx1032' o '10.3.0' — verificare la documentazione ROCm/driver per il valore corretto.
HSA_OVERRIDE_GFX_VERSION=gfx1032